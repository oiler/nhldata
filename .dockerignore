# VCS / editor / OS noise
.git
.github
.gitignore
.DS_Store
*.swp

# Python caches
__pycache__
*.pyc
.pytest_cache
.coverage
.venv
venv

# Secrets
.env
.env.*

# Pipeline data tree — only runtime_data/ is shipped, via browser/
data/
sample-data/
archive_*.tar.gz

# Other project subtrees the app doesn't need
pipeline/
research/
docs/
resources/

# Tests don't need to be in the runtime image
browser/tests/

# Deploy tooling not used at runtime
browser/sync-runtime-data.sh
browser/verify_runtime_data.py

# Top-level files the app doesn't need
README.md
GLOSSARY.md
Project\ Kickoff.md
pyproject.toml
uv.lock
fly.toml

# IDE
.vscode
.idea
