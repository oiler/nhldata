# Copy to ~/.config/nhl/pipeline.env on mininet and set mode 600.
# systemd reads this as KEY=value lines: no "export", no quotes needed.

# Where the data tree lives, outside the repository.
NHL_DATA_DIR=/home/YOUR_USER/nhl-data

# The season the daily run fetches, as its start year.
NHL_SEASON=2026

# A key for this machine only, with a spend limit, so it can be revoked alone.
ANTHROPIC_API_KEY=
